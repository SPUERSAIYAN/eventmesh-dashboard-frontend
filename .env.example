# Browser API prefix. Keep the default when using the Vite development proxy.
VITE_EVENTMESH_API_BASE_URL=/eventmesh/dashboard

# Vite proxy target for the local Spring Boot console.
VITE_EVENTMESH_API_PROXY_TARGET=http://127.0.0.1:9898

VITE_EVENTMESH_ORGANIZATION_ID=1
VITE_EVENTMESH_CLUSTER_TYPE=EVENTMESH_JVM_CLUSTER
VITE_EVENTMESH_API_TIMEOUT_MS=3500
